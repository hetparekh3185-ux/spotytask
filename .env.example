# Direct Gmail SMTP (Direct sending from spotytask@gmail.com)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=spotytask@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password

# Resend API Key (starts with re_...)
# Get one for free at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Server Port (default: 3000)
PORT=3000

